    "execute": [
      {
        "description": "create table \"accessToken\"",
        "sql": "CREATE TABLE \"public\".\"accessToken\" (\n  \"created_at\" timestamptz NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"token\" text NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
