          "\"public\".\"accessToken\""
        ]
      }
    ]
  },
  {
    "id": "unique.accessToken.accessToken_token_key",
    "label": "Add unique constraint on \"accessToken\" (token)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "accessToken_token_key",
        "table": "accessToken"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"accessToken_token_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "accessToken_token_key",
          "public",
          "\"public\".\"accessToken\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"accessToken_token_key\"",
        "sql": "ALTER TABLE \"public\".\"accessToken\" ADD CONSTRAINT \"accessToken_token_key\" UNIQUE (\"token\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"accessToken_token_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "accessToken_token_key",
          "public",
          "\"public\".\"accessToken\""
        ]
      }
    ]
