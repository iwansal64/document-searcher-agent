import ChatBox from "../components/ChatBox.astro";
import DocumentView from "../components/DocumentView.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="dashboard">
	<div class="w-full h-full flex flex-col gap-4 p-2">
		<Header />
		<div class="grid grid-cols-[3fr_2fr] gap-4 w-full h-full">
			<ChatBox />
			<DocumentView />
		</div>
	</div>
</MainLayout>
